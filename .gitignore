state/*.sqlite3-wal
state/checkpoints/**/*.tmp
state/browser/
state/wb_session_keeper/
state/wb_persistent_session/
state/wb_android_*/
state/wb_desktop_clean/
state/wb_manual_profile_reset/
state/wb_known_good/
state/wb_nightly_preflight/
state/run_reports/
state/locks/

