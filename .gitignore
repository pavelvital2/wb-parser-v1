# ------------------------------
# Python bytecode / caches
# ------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ------------------------------
# Build / packaging artifacts
# ------------------------------
dist/
build/
.eggs/
*.egg-info/

# ------------------------------
# Virtual environments
# ------------------------------
.venv/
venv/
env/

# ------------------------------
# Local env / secrets
# ------------------------------
.env
.env.*
!.env.example
config/runtime.env
config/runtime.env*
config/*.secret.*
config/*secret*
config/*request_headers*.json

# Cookie / auth local files
*cookie*.txt
config/*cookie*
*cookie*.txt.backup_*
*storage_state*.json
config/wb_cookie.txt

