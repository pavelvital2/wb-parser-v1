# Wildberries Unified Parser V1 environment example.
# Load manually in your shell or scheduler task (dotenv auto-load is not used).

# SERP cookie file path (overrides serp.wb_cookie_file in config.yaml)
WB_COOKIE_FILE=C:/parser_new/config/wb_cookie.txt

# Web UI operator credentials
WEBUI_ADMIN_PASSWORD=change_me
WEBUI_SECRET_KEY=change_me_long_random_secret_at_least_32_chars
